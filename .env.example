# MongoDB API KEY (Get from Mongo Atlas or local dashboard)
MONGODB_PUBLIC_KEY="your-mongodb-public-key"
MONGODB_PRIVATE_KEY="your-mongodb-private-key"

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connections (Local machine defaults, overridden in docker-compose.yml for container bridge network)
MONGODB_URI=mongodb://root:password@localhost:27017/helprest?authSource=admin
REDIS_URL=redis://localhost:6379

# Cryptography & Token Configuration
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=*

# Frontend App Environment
# Use localhost for iOS simulator or web:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Use 10.0.2.2 for Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
