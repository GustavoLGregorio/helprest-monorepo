{
  "name": "helprest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "reset-project": "bun ./scripts/reset-project.ts",
    "android": "expo run:android",
    "android:clean": "expo run:android --no-build-cache",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "bunx tsc --noEmit",
    "prebuild": "expo prebuild --clean && bun ./scripts/patch-android-signing.ts",
    "prebuild:android": "expo prebuild --clean --platform android && bun ./scripts/patch-android-signing.ts",
    "clean:gradle": "test -d android && (cd android && ./gradlew clean) || true",
    "clean:cache": "bunx rimraf node_modules/.cache .expo",
    "nuke": "bun run clean:gradle && bun run clean:cache && bun run prebuild:android",
    "build:apk:debug": "bun ./scripts/build-apk.ts debug",
    "build:apk:release": "bun ./scripts/build-apk.ts release"
  },
  "dependencies": {
    "@expo/ui": "~0.1.1-alpha.10",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.85.3",
    "expo": "~53.0.27",
    "expo-application": "~6.1.5",
    "expo-auth-session": "~6.2.1",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-maps": "~0.11.0",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
