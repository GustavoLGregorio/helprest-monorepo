{
  "name": "helprest-monorepo",
  "private": true,
  "workspaces": [
    "helprest-api",
    "helprest-app"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d mongodb redis",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f api",
    "prd:up": "docker compose -f docker-compose.prd.yml up -d --build",
    "prd:down": "docker compose -f docker-compose.prd.yml down",
    "api:dev": "cd helprest-api && bun run dev",
    "api:start": "cd helprest-api && bun run start",
    "api:seed": "cd helprest-api && bun run seed",
    "api:seed:docker": "docker exec helprest-api bun run seed",
    "api:test": "cd helprest-api && bun run test",
    "app:start": "cd helprest-app && bun run start",
    "app:start:clear": "cd helprest-app && bun run start:clear",
    "app:android": "cd helprest-app && bun run android",
    "app:android:clean": "cd helprest-app && bun run android:clean",
    "app:android:nuke": "cd helprest-app && bun run nuke",
    "app:build:apk:debug": "cd helprest-app && bun run build:apk:debug",
    "app:build:apk:release": "cd helprest-app && bun run build:apk:release",
    "app:eas:login": "cd helprest-app && bunx eas-cli login",
    "app:eas:build-apk-cloud": "cd helprest-app && bunx eas-cli build --platform android --profile preview",
    "app:eas:build-apk-local": "cd helprest-app && bunx eas-cli build --platform android --profile preview --local",
    "app:eas:build-aab": "cd helprest-app && bunx eas-cli build --platform android --profile production-aab",
    "typecheck": "bun run typecheck:api && bun run typecheck:app",
    "typecheck:api": "cd helprest-api && bun run typecheck",
    "typecheck:app": "cd helprest-app && bun run typecheck",
    "lint": "bun run lint:api && bun run lint:app",
    "lint:api": "cd helprest-api && bun run lint",
    "lint:app": "cd helprest-app && bun run lint"
  }
}
